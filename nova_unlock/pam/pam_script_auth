#!/bin/bash

# ── Auto-detect Nova installation ──────────────────
if [ -n "$NOVA_ROOT" ]; then
    NOVA_DIR="$NOVA_ROOT"
elif [ -n "$PAM_USER" ] && [ -d "/home/$PAM_USER/.local/share/nova-unlock" ]; then
    NOVA_DIR="/home/$PAM_USER/.local/share/nova-unlock"
elif [ -d "/opt/nova-unlock" ]; then
    NOVA_DIR="/opt/nova-unlock"
else
    NOVA_DIR="$(dirname "$(dirname "$(realpath "$0")")")"
fi

# ── Auto-detect real user ──────────────────────────
if [ -n "$PAM_USER" ]; then
    REAL_USER="$PAM_USER"
elif [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
    REAL_USER="$SUDO_USER"
else
    REAL_USER=$(logname 2>/dev/null || echo "$USER")
fi

# ── Logs ───────────────────────────────────────────
LOG_DIR="$NOVA_DIR/logs"
mkdir -p "$LOG_DIR"
LOGFILE="$LOG_DIR/pam_nova_face.log"
CACHE="/tmp/nova_face_pam_cache.json"

echo "$(date) PAM auth called for user: $REAL_USER" >> "$LOGFILE"

# ── Cache check ────────────────────────────────────
if [ -f "$CACHE" ]; then
    CACHE_RESULT=$(
        python3 - "$CACHE" << 'PY'
import json, sys, time
p = sys.argv[1]
try:
    d = json.load(open(p))
    u = str(d.get("user", "")).strip().lower()
    ts = float(d.get("ts", 0))
    if u and (time.time() - ts) <= 15:
        print(u)
except Exception:
    pass
PY
    )

    PAM_USER_CLEAN=$(echo "$REAL_USER" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')

    if [ -n "$CACHE_RESULT" ] && [ -n "$PAM_USER_CLEAN" ] && [ "$CACHE_RESULT" = "$PAM_USER_CLEAN" ]; then
        echo "$(date) CACHE HIT for $PAM_USER_CLEAN" >> "$LOGFILE"
        rm -f "$CACHE"
        exit 0
    fi

    echo "$(date) CACHE MISS cache=$CACHE_RESULT pam=$PAM_USER_CLEAN" >> "$LOGFILE"
    rm -f "$CACHE"
fi

echo "$(date) NO CACHE - use password" >> "$LOGFILE"
exit 1
