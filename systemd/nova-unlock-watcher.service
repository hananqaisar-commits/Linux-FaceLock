[Unit]
Description=NovaUnlock Face Presence Guard v5.2
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/bin/bash -c 'source %h/Desktop/NovaUnlock/.venv/bin/activate && python3 %h/Desktop/NovaUnlock/scripts/face_unlock_daemon.py --guard'
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/Desktop/NovaUnlock/logs/guard.log
StandardError=append:%h/Desktop/NovaUnlock/logs/guard.log
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority

[Install]
WantedBy=graphical-session.target
