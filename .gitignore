# Linux-FaceLock .gitignore

# Environment Variables & Secrets
.env
.env.*
*.pem
*.key
*.secret
.nova-private/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# C / C++ / Build Outputs
*.o
*.obj
*.dll
*.exe
*.so
*.dylib
*.a
*.lib
*.spec

# Release Packages & Large Models
/dist/
/build/
/releases/
/nova_bundle/
*.dat
*.tar.gz
*.tar.zst
*.deb
*.rpm
*.zip
*.sha256
*.manifest.txt

# Local User Data & Credentials
data/faces/
config/nova.conf
/data/
/config/

# IDE / Tool Caches
.claude/
.agents/
.gemini/
.vscode/
.idea/
*.swp
*.swo
*~
*.bak*

# OS specific
.DS_Store
Thumbs.db
